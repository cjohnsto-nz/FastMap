{
  "version": 1,
  "file": "fastmap.json",
  "patches": {},
  "settings": [
    {
      "type": "separator",
      "title": "Cache"
    },
    {
      "code": "PageTextureBudget",
      "type": "integer",
      "default": 512,
      "clientSide": true,
      "ingui": "Page texture budget",
      "comment": "Maximum number of cached map page textures kept in GPU memory before old off-screen pages are evicted.",
      "range": {
        "min": 16,
        "max": 10000,
        "step": 16
      }
    },
    {
      "code": "EnableTextureAtlas",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Use texture atlases",
      "comment": "Group uploaded map pages into larger GPU atlas textures. This reduces texture object churn and can improve large-map loading and panning."
    },
    {
      "code": "EnableCompressedCache",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Use compressed disk cache",
      "comment": "Write sparse LZ4-compressed cache files. Disable to write the older raw pages-v1 format."
    },
    {
      "code": "UseFilteredCache",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Use experimental filtered cache",
      "comment": "Write pages-v3 cache files using a channel-shuffle filter before LZ4 compression. This may reduce cache size for some worlds, but can increase it significantly depending on map data."
    },
    {
      "code": "UseHighCompressionCache",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Use LZ4HC cache writes",
      "comment": "Write compressed cache files with LZ4 high compression. This can reduce disk usage further, but costs more CPU while saving pages."
    },
    {
      "code": "CleanupKeepLatestPageVersion",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Cleanup keeps latest page version",
      "comment": "When running .fastmap cleanupcache, keep the newest pages-vN folder in each world cache and delete only older page-version folders."
    },
    {
      "code": "EnableVanillaMapDbWriteback",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Write vanilla map DB",
      "comment": "Also write generated FastMap terrain tiles back to Vintage Story's vanilla map database. Disabled by default so FastMap only writes its own page cache."
    },
    {
      "code": "CleanupStaleVanillaMapDbSidecarsOnStartup",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Clean vanilla DB sidecars",
      "comment": "Delete stale <world>.db-wal and <world>.db-shm files once on startup before FastMap opens the vanilla map database."
    },
    {
      "code": "ViewportLoadScale",
      "type": "float",
      "default": 1.5,
      "clientSide": true,
      "ingui": "Viewport load scale",
      "comment": "How much larger than the visible map viewport FastMap should keep loaded. 1.5 means 150% of the viewport.",
      "range": {
        "min": 1.0,
        "max": 4.0,
        "step": 0.05
      }
    },
    {
      "code": "EnablePrewarm",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Prewarm nearby tiles",
      "comment": "Generate and cache nearby map tiles in the background as you play."
    },
    {
      "code": "PrewarmRadiusChunks",
      "type": "integer",
      "default": 16,
      "clientSide": true,
      "ingui": "Prewarm radius (chunks)",
      "comment": "Radius around the player to prewarm when nearby-tile prewarming is enabled.",
      "range": {
        "min": 0,
        "max": 64,
        "step": 1
      }
    },
    {
      "code": "RegenerateOnChunkDirty",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Refresh changed chunks",
      "comment": "Regenerate cached map pixels for chunks marked dirty by the game."
    },
    {
      "type": "separator",
      "title": "Performance"
    },
    {
      "code": "MaxBackgroundTilesPerPass",
      "type": "integer",
      "default": 256,
      "clientSide": true,
      "ingui": "Background tiles per pass",
      "comment": "Maximum map tiles FastMap may process in one background worker pass.",
      "range": {
        "min": 1,
        "max": 1000,
        "step": 1
      }
    },
    {
      "code": "MaxParallelPageLoads",
      "type": "integer",
      "default": 4,
      "clientSide": true,
      "ingui": "Parallel page loads",
      "comment": "Maximum number of page cache load tasks that may run at once.",
      "range": {
        "min": 1,
        "max": 32,
        "step": 1
      }
    },
    {
      "code": "MaxPageUploadsPerTick",
      "type": "integer",
      "default": 2,
      "clientSide": true,
      "ingui": "Page uploads per tick",
      "comment": "Maximum number of page textures uploaded to the GPU per client tick.",
      "range": {
        "min": 1,
        "max": 32,
        "step": 1
      }
    },
    {
      "code": "MainThreadUploadBudgetMilliseconds",
      "type": "integer",
      "default": 4,
      "clientSide": true,
      "ingui": "Upload budget (ms)",
      "comment": "Approximate main-thread time budget for applying ready map textures each tick.",
      "range": {
        "min": 1,
        "max": 32,
        "step": 1
      }
    },
    {
      "code": "BackgroundWorkIntervalSeconds",
      "type": "float",
      "default": 0.01,
      "clientSide": true,
      "ingui": "Background work interval",
      "comment": "Seconds between background cache work passes.",
      "range": {
        "min": 0.01,
        "max": 1.0,
        "step": 0.01
      }
    },
    {
      "code": "PrewarmIntervalSeconds",
      "type": "float",
      "default": 2.0,
      "clientSide": true,
      "ingui": "Prewarm interval",
      "comment": "Seconds between nearby-tile prewarm scans.",
      "range": {
        "min": 0.25,
        "max": 30.0,
        "step": 0.25
      }
    },
    {
      "code": "PageFlushIntervalSeconds",
      "type": "float",
      "default": 5.0,
      "clientSide": true,
      "ingui": "Page flush interval",
      "comment": "Seconds between writing pending cached page snapshots to disk.",
      "range": {
        "min": 0.5,
        "max": 120.0,
        "step": 0.5
      }
    },
    {
      "code": "PageFlushThreshold",
      "type": "integer",
      "default": 64,
      "clientSide": true,
      "ingui": "Page flush threshold",
      "comment": "Flush pending page snapshots when this many pages are waiting to be saved.",
      "range": {
        "min": 1,
        "max": 10000,
        "step": 1
      }
    },
    {
      "type": "separator",
      "title": "Diagnostics"
    },
    {
      "code": "LogStats",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Log cache stats",
      "comment": "Write periodic FastMap cache statistics to client-main.log. Useful for diagnostics, noisy for normal play."
    },
    {
      "code": "LogStatsIntervalSeconds",
      "type": "float",
      "default": 5.0,
      "clientSide": true,
      "ingui": "Stats log interval",
      "comment": "Seconds between FastMap cache stat log lines when stat logging is enabled.",
      "range": {
        "min": 1.0,
        "max": 120.0,
        "step": 1.0
      }
    },
    {
      "code": "EnableHitchDiagnostics",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Log hitch diagnostics",
      "comment": "Log slow FastMap tick/render/off-thread passes to client-main.log. Leave disabled outside diagnostics."
    },
    {
      "code": "HitchDiagnosticThresholdMilliseconds",
      "type": "integer",
      "default": 100,
      "clientSide": true,
      "ingui": "Hitch threshold (ms)",
      "comment": "Minimum FastMap pass duration to log when hitch diagnostics are enabled.",
      "range": {
        "min": 16,
        "max": 5000,
        "step": 10
      }
    }
  ]
}
